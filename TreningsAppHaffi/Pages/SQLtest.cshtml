@page
@model SQLtestModel
@{
    ViewData["Title"] = "SQL Test";
}
<h1>@ViewData["Title"]</h1>

<!-- Knapp for å legge til en test- string i databasen
<form method="post" onsubmit="handleSubmit(this)">
    <button type="submit" id="insertBtn" asp-page-handler="Insert">
        Insert Test Row
    </button>

    <span id="processingMessage" style="display:none; margin-left:10px;">
        Processing...
    </span>
</form>
-->

<form method="post" onsubmit="handleSubmit(this)">
    <div>
        <label for="Description">Oppsummering</label><br />
        <input type="text" id="Description" name="Description" required />
    </div>

    <div style="margin-top:10px;">
        <label for="Text">Tekst / Beskrivelse</label><br />
        <textarea id="Text" name="Text" rows="5" cols="40" required></textarea>
    </div>

    <div style="margin-top:10px;">
        <button type="submit" id="insertBtn" asp-page-handler="Insert">
            Legg til i dagboken
        </button>

        <span id="processingMessage" style="display:none; margin-left:10px;">
            Processing...
        </span>
    </div>
</form>


<!-- Javascript for å vise "Processing..." og stopper evt bruker fra å klikke knappen flere ganger-->
<script>
    function handleSubmit(form) {
        const button = document.getElementById("insertBtn");
        const message = document.getElementById("processingMessage");

        // Disable button
        button.disabled = true;
        button.innerText = "Inserting...";

        // Show message
        message.style.display = "inline";

        // Allow form to continue submitting
        return true;
    }
</script>

<!-- Knapp for å rense innholdet i tabellen-->
<form method="post">
    <button type="submit" asp-page-handler="Clear">Clear Table</button>
</form>

<br />
<br />

<h3>Database SQL - Entries</h3>

@if (Model.SqlEntries != null && Model.SqlEntries.Any())
{
    foreach (var entry in Model.SqlEntries)
    {
        <div style="margin-bottom:10px; padding:10px; border:1px solid #ccc;">
            <strong>ID:</strong> @entry.Id <br />
            <strong>Date:</strong> @entry.CreatedDate <br />
            <strong>Description:</strong> @entry.Description <br />
            <strong>Text:</strong> @entry.Text
        </div>
    }
}
else
{
    <p>No entries found.</p>
}

<br />
<br />

<p>
    Her har jeg tenkt å lage en liten SQL dagbok. Jeg ønsker å starte med noe helt simpelt.<br />
    Legg til, Slett, Oppdater og Hent data fra en database. Jeg har tenkt å bruke AzureSQL server.<br />
    Tanken er å kun ha 1 tabell, med ID, Navn, Dato, og Beskrivelse. Det skal være en enkel treningsdagbok.
</p>
<p>
    Etter at jeg har laget den <i>enkle</i> databasen, Så har jeg tenkt å lage enda en SQL side hvor jeg prøver å lage et fiksjonelt program for å reservere noe.<br />
    Fex, reservere vaskemaskiner, bord, eller noe annet.<br />
    Tanken er at jeg må ha en tabell for brukere og en annen tabell for det som skal reserveres.
</p>
