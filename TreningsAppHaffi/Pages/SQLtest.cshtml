@page
@model SQLtestModel
@{
    ViewData["Title"] = "SQL Test";
}
<h1>@ViewData["Title"]</h1>

<div id="sqlStatus"
     style="margin-bottom:15px; padding:10px; border:2px dashed #ccc;">
    Connecting to SQL server...
</div>

<form method="post" onsubmit="handleSubmit(this)">

    <!-- User -->
    <div>
        <label>User: Guest</label>
    </div>

    <!-- Job -->
    <div style="margin-top:10px;">
        <label for="JobId">Type</label><br />
        <select id="JobId" name="JobId">
            <option value="0">ProsjektArbeid</option>
            <option value="1">Jobb</option>
            <option value="2">Fritid-Spill</option>
            <option value="3">Fritid-Bok</option>
            <option value="4">Fritid-Annet</option>
        </select>
    </div>

    <!-- Minutes -->
    <div style="margin-top:10px;">
        <label for="Minutes">Tid brukt</label><br />
        <select id="Minutes" name="Minutes">
            <option value="0">0 minutter</option>
            <option value="15">15 minutter</option>
            <option value="30">30 minutter</option>
            <option value="45">45 minutter</option>
            <option value="60">1 time</option>
            <option value="75">1 time 15 minutter</option>
            <option value="90">1 time 30 minutter</option>
            <option value="105">1 time 45 minutter</option>
            <option value="120">2 timer</option>
            <option value="135">2 timer 15 minutter</option>
            <option value="150">2 timer 30 minutter</option>
            <option value="165">2 timer 45 minutter</option>
            <option value="180">3 timer</option>
        </select>
    </div>

    <!-- Description -->
    <div style="margin-top:10px;">
        <label for="Description">Oppsummering</label><br />
        <input type="text" id="Description" name="Description" required />
    </div>

    <!-- Text -->
    <div style="margin-top:10px;">
        <label for="Text">Tekst / Beskrivelse</label><br />
        <textarea id="Text" name="Text" rows="5" cols="40" required></textarea>
    </div>

    <!-- Submit -->
    <div style="margin-top:10px;">
        <button type="submit" id="insertBtn" asp-page-handler="Insert" disabled>
            -Lagre innlegg-
        </button>

        <span id="processingMessage" style="display:none; margin-left:10px;">
            Processing...
        </span>
    </div>
</form>

<br />
<br />

<h3>Database SQL - Entries</h3>

<div id="sqlEntries">
    <p>Waiting for SQL server...</p>
</div>

<script>
    let sqlConnected = false;
    let retryDelay = 3000;
    let connectionAttempts = 0;

    async function checkSqlConnection() {

        connectionAttempts++;

        const status = document.getElementById("sqlStatus"); 
        const button = document.getElementById("insertBtn");

        button.disabled = true;

        status.innerText = "Connecting to SQL server...";

        try {
            
            const response = await fetch("?handler=CheckConnection"); 

            if (!response.ok) { 
                throw new Error( "Server returned an error." );
            }

            const result = await response.json();

            if (result.connected) {

                sqlConnected = true;
                status.innerText = "Connected to SQL server.";
                button.disabled = false;
                loadEntries();
            } else {
                sqlConnected = false;
                status.innerText = "Connection timed out. Retrying in " + (retryDelay / 1000) + " seconds... Attempt #" + connectionAttempts;
                setTimeout(checkSqlConnection, retryDelay);
            }
        } catch (error) {
            sqlConnected = false;
            status.innerText = "Unable to connect to SQL server. Retrying in " + (retryDelay / 1000) + " seconds... Attempt #" + connectionAttempts;
            setTimeout(checkSqlConnection, retryDelay);
        }
    }

    async function loadEntries() {

        const container = document.getElementById("sqlEntries");

        try {

            const response = await fetch("?handler=Entries");

            if (!response.ok) {
                return;
            }

            const entries = await response.json();

            container.innerHTML = "";

            if (entries.length === 0) {
                container.innerHTML = "<p>No entries found.</p>";
                return;
            }

            entries.forEach(entry => {
                const entryDiv = document.createElement("div");

                entryDiv.style.border = "1px solid #ccc";
                entryDiv.style.padding = "10px";
                entryDiv.style.marginBottom = "10px";

                const information = document.createElement("div");
                const date = new Date(entry.createdDate + "Z");
                const formattedDate = date.toLocaleString([], {
                        year: "numeric",
                        month: "2-digit",
                        day: "2-digit",
                        hour: "2-digit",
                        minute: "2-digit"
                    });

                information.innerHTML = `
                    <strong>Id:</strong>
                    <span class="entry-id"></span>

                    <strong>User:</strong>
                    <span class="entry-user"></span>

                    <strong>Date:</strong>
                    <span class="entry-date"></span>
                    <br />

                    <strong>Job:</strong>
                    <span class="entry-job"></span>

                    <strong>Minutes:</strong>
                    <span class="entry-minutes"></span>
                    <br />

                    <strong>Description:</strong>
                    <span class="entry-description"></span>
                `;

                information.querySelector(".entry-id").textContent = entry.id;
                information.querySelector(".entry-user").textContent = entry.userId;
                information.querySelector(".entry-date").textContent = formattedDate;
                information.querySelector(".entry-job").textContent = entry.jobId;
                information.querySelector(".entry-minutes").textContent = entry.minutes;
                information.querySelector(".entry-description").textContent = entry.description;
                entryDiv.appendChild(information);

                const textDiv = document.createElement("div");
                    textDiv.style.marginBottom = "2px";
                    textDiv.style.paddingLeft = "10px";
                    textDiv.style.borderLeft = "5px solid #ccc";
                    textDiv.style.whiteSpace = "pre-wrap"; // for linebreaks og lignende
                const textLabel = document.createElement("strong");
                    textLabel.textContent = "Text:";
                    textDiv.appendChild(textLabel);
                    textDiv.appendChild(document.createElement("br")); // Vil ha linjeskift etter Text:
                const textContent = document.createElement("span");
                    textContent.textContent = entry.text;
                    textDiv.appendChild(textContent);

                entryDiv.appendChild(textDiv);
                container.appendChild(entryDiv);
            });


        } catch (error) {
            container.innerHTML = "<p>Error loading entries.</p>";
        }
    }

    function handleSubmit(form) {

        if(!sqlConnected) {
            return false;
        }

        const button = document.getElementById("insertBtn");
        const processingMessage = document.getElementById("processingMessage");
        button.disabled = true;
        button.innerText = "Inserting...";
        processingMessage.style.display = "inline";

        return true;
    }

    checkSqlConnection();

</script>