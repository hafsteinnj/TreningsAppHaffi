<div id="timer">00:00</div>

<script>
    let started = false;
    let seconds = 0;

    function startTimer() {
        if (started) return;
        started = true;

        setInterval(() => {
            if (seconds >= 5999) return;

            seconds++;
            let m = String(Math.floor(seconds / 60)).padStart(2, '0');
            let s = String(seconds % 60).padStart(2, '0');
            document.getElementById("timer").innerText = `${m}:${s}`;
        }, 1000);
    }
</script>
