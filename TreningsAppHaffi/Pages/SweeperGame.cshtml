@page
@model TreningsAppHaffi.Pages.SweeperGameModel

<style>
    .cell {
        width: 30px;
        height: 30px;
        padding: 0;
        font-weight: bold;
        border: 2px solid #bbb;
        background-color: #ddd;
        cursor: pointer;
    }

        .cell:not(.revealed):not(:disabled) {
            box-shadow: inset -2px -2px 0 #888, inset 2px 2px 0 #fff;
        }

            .cell:not(.revealed):not(:disabled):hover {
                background-color: #eee;
            }

        .cell.revealed {
            background-color: #bdbdbd;
            border: 1px solid #999;
            box-shadow: none;
            cursor: default;
        }

        .cell.mine {
            background-color: #e57373;
            color: black;
        }

        .cell.flag {
            background-color: #fff176;
        }

        .cell:disabled {
            cursor: default;
            opacity: 0.85;
        }

        .cell.n1 {
            color: blue;
        }

        .cell.n2 {
            color: green;
        }

        .cell.n3 {
            color: red;
        }

        .cell.n4 {
            color: darkblue;
        }

        .cell.n5 {
            color: brown;
        }

        .cell.n6 {
            color: teal;
        }

        .cell.n7 {
            color: black;
        }

        .cell.n8 {
            color: gray;
        }

    #controls {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }

    #newGameBtn.attention {
        font-weight: 900;
        border: 3px solid #d32f2f;
    }

    #flagModeBtn.active {
        box-shadow: inset -2px -2px 0 #888, inset 2px 2px 0 #fff;
        background-color: #fff176;
    }

    #timer {
        font-weight: bold;
    }
</style>

<p>
    UNDER CONSTRUCTION - OBS - Minesweeperen funker nå, inkludert flagging (via flagg-knappen, ikke høyreklikk),
    timer, og game over/win-tilstand.
</p>

<form method="post">
    <div id="controls">
        <button id="newGameBtn"
                type="submit"
                formaction="?handler=NewGame"
                class="@(Model.Locked ? "attention" : "")">
            New Game
        </button>

        <button id="flagModeBtn"
                type="submit"
                formaction="?handler=ToggleFlagMode"
                disabled="@Model.Locked"
                class="@(Model.FlagMode ? "active" : "")"
                title="Toggle flag placement mode">
            🚩 Flag mode: @(Model.FlagMode ? "ON" : "OFF")
        </button>

        <div id="timer">@Model.ElapsedDisplay</div>
    </div>

    <div id="grid" style="display:grid; grid-template-columns: repeat(@Model.Width, 30px);">
        @for (int y = 0; y < Model.Height; y++)
        {
            for (int x = 0; x < Model.Width; x++)
            {
                var cell = Model.GetCell(x, y);
                bool cellDisabled = Model.Locked || cell.IsRevealed || (cell.IsFlagged && !Model.FlagMode);

                <button type="submit"
                        formaction="?handler=Reveal&x=@x&y=@y"
                        disabled="@cellDisabled"
                        class="cell
                    @(cell.IsRevealed ? "revealed" : "")
                    @(cell.IsMine && cell.IsRevealed ? "mine" : "")
                    @(cell.IsFlagged ? "flag" : "")
                    @(cell.AdjacentMines > 0 && cell.IsRevealed ? $"n{cell.AdjacentMines}" : "")">
                    @if (cell.IsRevealed)
                    {
                        if (cell.IsMine)
                        {
                            <span>X</span>
                        }
                        else if (cell.AdjacentMines > 0)
                        {
                            <span>@cell.AdjacentMines</span>
                        }
                    }
                    else if (cell.IsFlagged)
                    {
                        <span>!</span>
                    }
                </button>
            }
        }
    </div>
</form>

@if (Model.GameOver)
{
    <h2>Game Over</h2>
}
@if (Model.GameWon)
{
    <h2>You Won!</h2>
}

<script>
    // Ticks the displayed timer between postbacks. Re-synced to the real,
    // server-tracked elapsed time on every page load, so it can't drift -
    // it's purely visual between clicks.
    (function() {
        let seconds = @Model.ElapsedSeconds;
        const el = document.getElementById("timer");
        const running = @(Model.Locked ? "false" : "true");

        if (running) {
            setInterval(() => {
                seconds++;
                const m = String(Math.floor(seconds / 60)).padStart(2, "0");
                const s = String(seconds % 60).padStart(2, "0");
                el.textContent = `${m}:${s}`;
            }, 1000);
        }
    })();
</script>
