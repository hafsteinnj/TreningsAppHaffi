<style id="b1jvmp">
    .cell {
        width: 30px;
        height: 30px;
        padding: 0;
        font-weight: bold;
        border: 2px solid #bbb;
        background-color: #ddd;
        cursor: pointer;
    }

    /* 👇 Unrevealed (default button look) */
.cell:not(.revealed) {
    box-shadow: inset -2px -2px 0 #888, inset 2px 2px 0 #fff;
}

.cell:not(.revealed):hover {
    background-color: #eee;
}

/* 👇 Revealed cells (flat look) */
.cell.revealed {
    background-color: #bdbdbd;
    border: 1px solid #999;
    box-shadow: none;
    cursor: default;
}

/* 💣 Mine */
.cell.mine {
    background-color: #e57373;
    color: black;
}

/* 🚩 Flag */
.cell.flag {
    background-color: #fff176;
}

/* 🔢 Number colors (classic style) */
.cell.n1 { color: blue; }
.cell.n2 { color: green; }
.cell.n3 { color: red; }
.cell.n4 { color: darkblue; }
.cell.n5 { color: brown; }
.cell.n6 { color: teal; }
.cell.n7 { color: black; }
.cell.n8 { color: gray; }
</style>

<p>UNDER CONSTRUCTION - OBS - Mine sweeperen funker nå, men høyreklikk for å markere flagg funker ikke enda. Men jeg regner med å få det til før møtet med trond på torsdag.
    <br/><s>Ting krasjer pga noe tull i AI-koden. Så jeg må gå igjenom koden for å finne ut hva som skjer.</s><br/></p>


<form method="post">
    <button asp-page-handler="NewGame">New Game</button>
</form>

<div id="grid"
     style="display:grid; grid-template-columns: repeat(@Model.Width, 30px);">

    @for (int y = 0; y < Model.Height; y++)
    {
        for (int x = 0; x < Model.Width; x++)
        {
            var cell = Model.GameGrid[x, y];

            <form method="post" style="display:inline;">
                <input type="hidden" name="x" value="@x" />
                <input type="hidden" name="y" value="@y" />

                <button formaction="?handler=Reveal"
                        onclick="@( (!cell.IsRevealed && !cell.IsFlagged) ? "startTimer()" : "" )"
                        oncontextmenu="flag(event, @x, @y)"
                        class="cell
                               @(cell.IsRevealed ? "revealed" : "")
                               @(cell.IsMine && cell.IsRevealed ? "mine" : "")
                               @(cell.IsFlagged ? "flag" : "")
                               @(cell.AdjacentMines > 0 && cell.IsRevealed ? $"n{cell.AdjacentMines}" : "")">

                    @if (cell.IsRevealed)
                    {
                        if (cell.IsMine)
                        {
                            <span>X</span>
                        }
                        else if (cell.AdjacentMines > 0)
                        {
                            <span>@cell.AdjacentMines</span>
                        }
                    }
                    else if (cell.IsFlagged)
                    {
                        <span>!</span>
                    }
                </button>
            </form>
        }
    }
</div>

@if (Model.GameOver)
{
    <h2>Game Over</h2>
}
@if (Model.GameWon)
{
    <h2>You Won!</h2>
}

