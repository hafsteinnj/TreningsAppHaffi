@page
@model TreningsAppHaffi.Pages.NavApiListModel

<h1>NAV Job Advertisements</h1>

<form method="post" id="syncForm">
    <button type="submit" asp-page-handler="Sync" id="syncButton">
        Sync with NAV
    </button>

    <span id="syncStatus"></span>
</form>

@if (ViewData["SyncResult"] is string result)
{
    <p>
        <strong>@result</strong>
    </p>
}

<hr />

<div id="jobList">
    <p>Loading saved job advertisements...</p>
</div>

<script>
    async function loadSavedJobs() {
        const jobList = document.getElementById("jobList");

        try {
            const response = await fetch("?handler=Jobs");

            if (!response.ok) {
                throw new Error("Could not load saved jobs.");
            }

            const jobs = await response.json();

            if (jobs.length === 0) {
                jobList.innerHTML =
                    "<p>No saved job advertisements.</p>";
                return;
            }

            jobList.innerHTML = "";

            for (const job of jobs) {
                const jobElement = document.createElement("div");

                jobElement.innerHTML = `
                        <strong>${job.title}</strong><br />
                        ${job.employer ?? ""}<br />
                        ${job.municipality ?? ""}<br />
                        Published: ${job.publishedDate
                        ? new Date(job.publishedDate).toLocaleDateString("no-NO")
                        : ""}<br />
                        Deadline: ${job.deadline
                        ? new Date(job.deadline).toLocaleDateString("no-NO")
                        : ""}<br />
                        ${job.position ?? ""}<br />
                        ${job.url
                        ? `<a href="${job.url}" target="_blank">
                                   View job advertisement
                               </a>`
                        : ""}
                        <hr />
                    `;

                jobList.appendChild(jobElement);
            }
        }
        catch (error) {
            jobList.innerHTML =
                "<p>Could not load saved job advertisements.</p>";
        }
    }

    loadSavedJobs();
</script>

<script>
    document.getElementById("syncForm").addEventListener("submit", function () {
        const button = document.getElementById("syncButton");
        const status = document.getElementById("syncStatus");

        button.disabled = true;
        button.textContent = "Syncing...";
        status.textContent = " Please wait...";
    });
</script>