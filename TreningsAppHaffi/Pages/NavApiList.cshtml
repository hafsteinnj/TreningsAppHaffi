@page
@model TreningsAppHaffi.Pages.NavApiListModel

<h1>NAV API Test</h1>

@if (Model.Feed != null)
{
    <p>Received @Model.Feed.Items.Count advertisements.</p>

    @foreach (var job in Model.Feed.Items)
    {
        <div>
            <strong>@job.Title</strong><br />
            @job.FeedEntry?.BusinessName<br />
            Municipality: @job.FeedEntry?.Municipal<br />
            Status: @job.FeedEntry?.Status
        </div>

        <hr />
    }
}